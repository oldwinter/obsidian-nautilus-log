{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oldwinter/obsidian-nautilus-log/blob/main/scripts/release/schemas/requirements.schema.json",
  "title": "Spiral Day parity requirement manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "requirement_set",
    "upstream_baseline_sha",
    "row_count",
    "counts",
    "evidence_binding",
    "fixture_catalog",
    "test_catalog",
    "environment_catalog",
    "requirements"
  ],
  "properties": {
    "$schema": {
      "const": "../../scripts/release/schemas/requirements.schema.json"
    },
    "schema_version": { "const": 1 },
    "requirement_set": { "const": "UPSTREAM-MATRIX-v1+INITIAL-OBS-REL-v1" },
    "upstream_baseline_sha": {
      "const": "973a041aa2f59f3b05bf31db8187efbfea07017a"
    },
    "row_count": { "const": 126 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream", "obsidian", "release"],
      "properties": {
        "upstream": { "const": 114 },
        "obsidian": { "const": 9 },
        "release": { "const": 3 }
      }
    },
    "evidence_binding": { "const": "candidate-evidence-index" },
    "fixture_catalog": {
      "type": "array",
      "minItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/catalogEntry" }
    },
    "test_catalog": {
      "type": "array",
      "minItems": 126,
      "items": { "$ref": "#/$defs/testEntry" }
    },
    "environment_catalog": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/catalogEntry" }
    },
    "requirements": {
      "type": "array",
      "minItems": 126,
      "maxItems": 126,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "requirementId": {
      "type": "string",
      "pattern": "^(?:UP-(?:INS|SET|PAR|SCH|DAY|HIS|VIS|CTL|CMP|EXE|CLK|CMD|PER|ERR|ERX|DRF)-[0-9]{2}|OBS-(?:TRACE|HOST|VIS|A11Y|SAFE|LIFE|I18N|LOCAL)-[0-9]{3}|REL-[0-9]{3})$"
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://github\\.com/[^/]+/[^/]+/blob/[0-9a-f]{40}/"
      }
    },
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      }
    },
    "testEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement_id", "evidence_kind", "gates"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TC-(?:UP-[A-Z]{3}-[0-9]{2}|OBS-[A-Z0-9]+-[0-9]{3}|REL-[0-9]{3})-[0-9]{3}$"
        },
        "requirement_id": { "$ref": "#/$defs/requirementId" },
        "evidence_kind": {
          "enum": [
            "UNIT",
            "CONTRACT",
            "VAULT",
            "INTEGRATION",
            "SCREENSHOT",
            "KEYBOARD",
            "A11Y",
            "LIFECYCLE",
            "PACKAGE",
            "MANUAL"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8", "G9"] }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner_ticket",
        "owner_module",
        "evidence_contributors",
        "statement",
        "source_refs",
        "disposition",
        "fixtures",
        "tests",
        "environments",
        "evidence",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/requirementId" },
        "owner_ticket": { "type": "integer", "minimum": 17, "maximum": 31 },
        "owner_module": { "type": "string", "minLength": 1 },
        "evidence_contributors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 17, "maximum": 31 }
        },
        "statement": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "disposition": {
          "enum": ["exact", "host-adapted", "approved-improvement", "not-applicable"]
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:FX-[0-9]{2}|OFX-[0-9]{3})$" }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^TC-" }
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ENV-[A-Z0-9]+(?:-[A-Z0-9]+)*$" }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^E-" }
        },
        "status": { "enum": ["active", "retired"] },
        "deviation_id": { "type": "string", "pattern": "^DEV-[0-9]{3}$" },
        "not_applicable_approval_id": { "type": "string", "pattern": "^NA-[0-9]{3}$" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": { "enum": ["host-adapted", "approved-improvement"] }
            },
            "required": ["disposition"]
          },
          "then": { "required": ["deviation_id"] },
          "else": { "not": { "required": ["deviation_id"] } }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "not-applicable" } },
            "required": ["disposition"]
          },
          "then": { "required": ["not_applicable_approval_id"] },
          "else": { "not": { "required": ["not_applicable_approval_id"] } }
        }
      ]
    }
  }
}
